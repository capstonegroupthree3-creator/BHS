{
  "name": "smart-barangay-health",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start:db": "node ./database/start-db.js",
    "start:backend": "npm --prefix backend run start",
    "start:ai": "npm --prefix ai run start",
    "start:frontend": "npm --prefix frontend run dev",
    "dev": "npm-run-all --parallel start:db start:backend start:ai start:frontend"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}

